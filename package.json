{
  "name": "clipshaper",
  "version": "1.0.0",
  "main": "src/main.js",
  "productName": "Clipshaper",
  "description": "Clipshaper by Hollowbit: free, offline short clips. Drop in a long video and get vertical, captioned clips of its best moments. Nothing is uploaded.",
  "author": "Elvis Zygmanta",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "test:engine": "node test/engine.mjs",
    "site": "node site/build.mjs",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "test": "node test/e2e.mjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright": "1.48",
    "@mediapipe/tasks-vision": "^1.2.3"
  },
  "build": {
    "appId": "dev.hollowbit.clipshaper",
    "productName": "Clipshaper",
    "directories": {
      "output": "dist",
      "buildResources": "installer"
    },
    "files": [
      "src/**/*",
      "assets/fonts/**/*",
      "assets/icon.png",
      "package.json",
      "!src/**/.DS_Store"
    ],
    "asarUnpack": [
      "assets/fonts/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_internal.js",
        "to": "faces/vision_wasm_internal.js"
      },
      {
        "from": "node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_internal.wasm",
        "to": "faces/vision_wasm_internal.wasm"
      },
      {
        "from": "node_modules/@mediapipe/tasks-vision/vision_bundle.mjs",
        "to": "faces/vision_bundle.mjs"
      },
      {
        "from": "vendor/models/blaze_face_short_range.tflite",
        "to": "faces/blaze_face_short_range.tflite"
      },
      {
        "from": "vendor/models/ggml-silero-v5.1.2.bin",
        "to": "models/ggml-silero-v5.1.2.bin"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "assets/icon.png",
      "identity": null,
      "artifactName": "Clipshaper-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/darwin-${arch}/ffmpeg",
          "to": "ffmpeg/ffmpeg"
        },
        {
          "from": "vendor/whisper/darwin-${arch}",
          "to": "whisper"
        },
        {
          "from": "vendor/llama/darwin-${arch}",
          "to": "llama"
        }
      ],
      "fileAssociations": [
        {
          "ext": [
            "mp4",
            "mov",
            "m4v",
            "mkv",
            "webm"
          ],
          "name": "Video file",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "vendor/ffmpeg/win32-x64/ffmpeg.exe",
          "to": "ffmpeg/ffmpeg.exe"
        },
        {
          "from": "vendor/whisper/win32-x64",
          "to": "whisper"
        },
        {
          "from": "vendor/llama/win32-x64",
          "to": "llama"
        },
        {
          "from": "vendor/redist/vc_redist.x64.exe",
          "to": "redist/vc_redist.x64.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Clipshaper-Setup-${version}-win-x64.exe",
      "include": "installer/installer.nsh"
    },
    "afterPack": "scripts/after-pack.js",
    "copyright": "\u00a9 2026 Hollowbit \u00b7 Elvis Zygmanta"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hollowbit-dev/clipshaper.git"
  },
  "homepage": "https://hollowbit.dev/clipshaper/"
}
